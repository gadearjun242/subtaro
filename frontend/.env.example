# App branding — change this and the whole app renames itself
VITE_APP_NAME=Subtaro
VITE_APP_TAGLINE=Subtitles, generated in minutes.

# Backend API base URL (Node/Express server from /backend)
VITE_API_URL=http://localhost:5000/api

# Socket.IO server URL (same host as backend, no /api suffix)
VITE_SOCKET_URL=http://localhost:5000

# Max upload size shown/enforced client-side, in MB.
# Keep in sync with the backend's MAX_UPLOAD_SIZE_BYTES.
VITE_MAX_UPLOAD_SIZE_MB=10
