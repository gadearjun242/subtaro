# ============================================================
# Application
# ============================================================

# Runtime environment
NODE_ENV=development

# Server host and port
HOST=0.0.0.0
PORT=5000

# Public API URL
PUBLIC_API_URL=http://localhost:5000

# Name shown in email templates
APP_NAME=Subtaro

# Frontend application URL
FRONTEND_URL=http://localhost:3000

# Allowed client URL(s)
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3000

# API documentation URL
API_DOCS_URL=http://localhost:5000/api-docs

# API version
API_VERSION=v1


# ============================================================
# Database
# ============================================================

# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/subtitle


# ============================================================
# Authentication / JWT
# ============================================================

# CHANGE THESE IN REAL ENVIRONMENTS
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret

# Access token expiration
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token expiration
JWT_REFRESH_EXPIRES_IN=7d


# ============================================================
# Email / SMTP
# ============================================================

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# STARTTLS
SMTP_SECURE=false

# SMTP timeouts in milliseconds
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=10000

# SMTP connection limits
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# Email addresses
MAIL_FROM=noreply@localhost
MAIL_REPLY_TO=noreply@localhost

# Verification email expiration
EMAIL_VERIFICATION_EXPIRES_HOURS=24


# ============================================================
# Cloudinary
# ============================================================

# Add your Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ============================================================
# Video / FFmpeg
# ============================================================

# FFmpeg executable
# Linux: /usr/bin/ffmpeg
# macOS: /opt/homebrew/bin/ffmpeg
FFMPEG_BIN=ffmpeg

# Used to detect a source video's codec before deciding whether
# "selectable" mode can safely stream-copy it into an .mp4, or
# needs to transcode first (e.g. HEVC sources). Ships alongside
# ffmpeg in virtually every install/package, including the Docker image.
FFPROBE_BIN=ffprobe

# Video quality
FFMPEG_CRF=23

# Encoding preset
FFMPEG_PRESET=veryfast


# ============================================================
# File Uploads / Storage
# ============================================================

# Maximum upload size: 10 MB
MAX_UPLOAD_SIZE_BYTES=10485760

# Maximum source download size (should stay >= MAX_UPLOAD_SIZE_BYTES,
# since this is what re-downloads the project's own uploaded file
# during output rendering): 10 MB
MAX_SOURCE_DOWNLOAD_BYTES=10485760

# Maximum subtitle download size: 50 MB
MAX_SUBTITLE_DOWNLOAD_BYTES=52428800

# Temporary upload directory
TEMP_UPLOAD_DIR=/tmp/subtitle


# ============================================================
# HTTP / Request Limits
# ============================================================

# JSON request body limit
JSON_BODY_LIMIT=10mb

# URL-encoded request body limit
URLENCODED_BODY_LIMIT=10mb


# ============================================================
# Subtitle Service
# ============================================================

# Local subtitle service
SUBTITLE_SERVICE_URL=http://localhost:8000

# Subtitle service timeout: 5 minutes
SUBTITLE_SERVICE_TIMEOUT_MS=300000


# ============================================================
# Webhooks
# ============================================================

# CHANGE THIS IN REAL ENVIRONMENTS
WEBHOOK_MASTER_SECRET=change-me-to-a-long-random-webhook-secret

# Webhook download timeout: 2 minutes
WEBHOOK_DOWNLOAD_TIMEOUT_MS=120000


# ============================================================
# Project
# ============================================================

# Prefix for generated project IDs
PROJECT_ID_PREFIX=proj

# ============================================================
# Redis / Render Queue (BullMQ)
# ============================================================
#
# Used only for the video-render job queue - not a general
# cache. MongoDB (Atlas or otherwise) remains the only datastore
# for application data.

# Local dev default; in Docker Compose this is redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# How many render jobs this process's worker processes at once.
# Each job runs an FFmpeg encode, which is CPU/memory heavy -
# keep this modest unless the host has real headroom.
RENDER_WORKER_CONCURRENCY=2

# Set to "false" if you're running a separate dedicated worker
# process/container (node worker.js) instead of the default
# in-process worker started from server.js.
ENABLE_RENDER_WORKER=true

# Retry behavior for failed render jobs
RENDER_JOB_MAX_ATTEMPTS=3
RENDER_JOB_BACKOFF_MS=15000


# ============================================================
# Error Tracking (Sentry) - optional
# ============================================================
#
# Leave blank to disable entirely - the app runs fine without
# it, errors just stay in console.error/server logs only.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
